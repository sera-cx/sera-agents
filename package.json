{
  "name": "sera-agents",
  "version": "0.7.3",
  "private": true,
  "description": "Agent templates, x402 services, docs, demos, and host integrations built on top of sera-mcp.",
  "workspaces": [
    "agents-gateway",
    "sera-agent",
    "x402-service",
    "templates/chat-cli",
    "templates/web-chat",
    "templates/webhook-agent",
    "templates/slack-agent",
    "templates/market-maker",
    "templates/withdraw-cli",
    "templates/discord-agent",
    "examples/invoice-payer",
    "examples/treasury-rebalancer"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "biome:check": "biome check --changed --no-errors-on-unmatched",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "audit": "npm audit --workspaces --audit-level=high",
    "check": "npm run biome:check && npm run typecheck && npm run audit",
    "ci": "npm ci && npm run biome:check && npm run typecheck && npm run build && npm run test && npm run audit",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.css -o assets/tailwind.css --minify",
    "check:css": "npm run build:css && git diff --exit-code -- assets/tailwind.css"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "axios": "^1.21.0",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.2",
    "hono": "^4.12.34",
    "ip-address": "^10.3.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.15.2",
    "undici": "^6.29.1",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "tailwindcss": "4.3.4"
  }
}

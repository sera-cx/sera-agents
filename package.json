{
  "name": "sera-agents",
  "version": "0.7.3",
  "private": true,
  "description": "Agent templates, x402 services, docs, demos, and host integrations built on top of sera-mcp.",
  "workspaces": [
    "agents-gateway",
    "sera-agent",
    "x402-service",
    "templates/chat-cli",
    "templates/web-chat",
    "templates/webhook-agent",
    "templates/slack-agent",
    "templates/market-maker",
    "templates/withdraw-cli",
    "templates/discord-agent",
    "examples/invoice-payer",
    "examples/treasury-rebalancer"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "biome:check": "biome check --changed --no-errors-on-unmatched",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "audit": "npm audit --workspaces --audit-level=high",
    "check": "npm run biome:check && npm run typecheck && npm run audit",
    "ci": "npm ci && npm run biome:check && npm run typecheck && npm run build && npm run test && npm run audit"
  },
  "overrides": {
    "qs": "^6.17.0",
    "ws": "^8.21.0",
    "@hono/node-server": "^2.1.3",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.16",
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "axios": "^1.21.1",
    "follow-redirects": "^1.16.3",
    "undici": "^6.29.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.6",
    "body-parser@1": "^1.20.9",
    "body-parser@2": "^2.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7"
  }
}

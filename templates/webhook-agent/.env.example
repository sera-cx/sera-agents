# templates/webhook-agent — HTTP webhook responder that runs an agent task per request.

# Required.
OPENAI_API_KEY=sk-...

# Port and host the Express server listens on.
PORT=4000
HOST=127.0.0.1

# ─── Webhook Authentication ────────────────────────────────
# REQUIRED for production (bearer token gate).
WEBHOOK_SECRET=replace-with-long-random-secret

# Only set to true for local development on HOST=127.0.0.1 without auth:
# WEBHOOK_ALLOW_NO_AUTH=false

# ─── HMAC verification (recommended for production) ────────
# none (default) | stripe | github | generic
WEBHOOK_HMAC_PROVIDER=none
# WEBHOOK_HMAC_SECRET=whsec_replace_me
# WEBHOOK_HMAC_TOLERANCE_SECONDS=300

# ─── Rate Limiting & Concurrency ───────────────────────────
# Tier 1 — server-wide burst ceiling across ALL clients combined. Protects
# the event loop and LLM spend from distributed floods. Finite positive
# integer; invalid values abort startup.
# WEBHOOK_GLOBAL_RATE_LIMIT=300

# Tier 2 — per-client quota per minute, keyed by client IP. Finite positive
# integer; invalid values abort startup.
# WEBHOOK_RATE_LIMIT_PER_MIN=60

# Trust exactly one reverse-proxy hop when resolving client IPs from
# X-Forwarded-For. Enable ONLY behind a proxy you control — direct
# deployments must keep this false or clients can spoof their identity.
# WEBHOOK_TRUST_PROXY=false

# Max concurrent agent tasks in flight (bounded slot pool).
# WEBHOOK_MAX_CONCURRENT=4
#
# NOTE: rate-limit counters live in this process's memory. Behind multiple
# replicas each instance enforces its own budget — use a shared
# express-rate-limit store (e.g. rate-limit-redis) or a single instance
# for exact global caps.

# Required only if SERA_MCP_URL is not set. Path to a built sera-mcp/dist/index.js.
SERA_MCP_DIST=/absolute/path/to/sera-mcp/dist/index.js

# Optional: takes precedence over SERA_MCP_DIST and connects over Streamable
# HTTP instead of spawning a local MCP process. The hosted endpoint is keyless.
# SERA_MCP_URL=https://agents.sera.cx/mcp
# Optional Bearer token for a self-hosted SERA_MCP_URL. Never commit a real token.
# Requires an https:// SERA_MCP_URL, or an explicit localhost/127.0.0.1/::1 URL
# for local dev — plaintext http to any other host is rejected at startup.
# SERA_MCP_TOKEN=replace-with-your-token

# Forwarded to the spawned sera-mcp child:
SERA_NETWORK=mainnet
SERA_SIGNER_MODE=external
SERA_ENABLE_EXECUTION_TOOLS=false   # webhooks should NEVER expose execute_swap by default
POLICY_PRESET=standard

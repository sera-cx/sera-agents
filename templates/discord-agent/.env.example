# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED VARIABLES
# ──────────────────────────────────────────────────────────────────────────────

# The Discord Bot user token from the Developer Portal
DISCORD_TOKEN=your-discord-bot-token-here

# OpenAI API key for Agent LLM (gpt-4o or similar)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Path to the compiled model context protocol child server (sera-mcp) entrypoint
# Example: /Users/username/Desktop/sera-mcp/dist/index.js
SERA_MCP_DIST=path-to-sera-mcp-dist-index-js


# ──────────────────────────────────────────────────────────────────────────────
# AUTHORIZATION BOUNDARIES
#
# At least one allowlist (users, guilds, or channels) MUST be configured.
# The bot will refuse to start without one to protect the operator's OpenAI
# quota. If a fully public bot is intentional, set DISCORD_PUBLIC_MODE_ACK=true.
#
# Each allowlist is comma-separated. If set, only matching entities are
# permitted (fail-closed). For threads, the parent channel ID is checked
# against the channel allowlist.
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated Discord user IDs authorized to interact with the bot.
# REQUIRED when DISCORD_ALLOW_DMS=true (guild/channel allowlists cannot protect DMs).
# DISCORD_ALLOWED_USER_IDS=111111111111111111,222222222222222222

# Comma-separated Discord guild (server) IDs where the bot will respond
# DISCORD_ALLOWED_GUILD_IDS=333333333333333333

# Comma-separated Discord channel IDs where the bot will respond.
# For threads, use the parent channel ID.
# DISCORD_ALLOWED_CHANNEL_IDS=444444444444444444,555555555555555555

# Enable Direct Messages (default: false). DMs are disabled by default to
# prevent unauthorized users from consuming operator resources privately.
# When true, DISCORD_ALLOWED_USER_IDS MUST also be set.
DISCORD_ALLOW_DMS=false

# Explicit acknowledgement for running without any allowlist (public bot).
# Only set this if you intentionally want every Discord user to be able to
# invoke the bot and consume your OpenAI quota.
# DISCORD_PUBLIC_MODE_ACK=true


# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL CONFIGURATIONS
# ──────────────────────────────────────────────────────────────────────────────

# Development Server Guild ID (allows instant Slash Command registration)
# DISCORD_GUILD_ID=your-guild-id-here

# Concurrency slot limit (max simultaneous agent runs). Must be a positive
# integer; invalid values fall back to the default.
# DISCORD_MAX_CONCURRENT=4

# Network target: mainnet or testnet
SERA_NETWORK=mainnet

# Signer mode (pinned to external in code for security)
SERA_SIGNER_MODE=external

# Disable execution tools by default (pinned to false in code for security on untrusted surfaces)
SERA_ENABLE_EXECUTION_TOOLS=false

# Policy preset profile for MCP command execution
POLICY_PRESET=standard

# Logging granularity: error, warn, info, debug
LOG_LEVEL=warn


# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL SERA EXECUTION CREDENTIALS (Required for live conversions & balances)
#
# WARNING: When these are set, at least one authorization allowlist above
# MUST also be configured, or the bot will refuse to start.
# ──────────────────────────────────────────────────────────────────────────────

# SERA_API_KEY=your-sera-api-key
# SERA_API_SECRET=your-sera-api-secret

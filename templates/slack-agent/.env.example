# templates/slack-agent — Slack bot agent over sera-mcp.

# Required.
OPENAI_API_KEY=sk-...
SLACK_BOT_TOKEN=xoxb-...

# Dynamic Dual-Transport Config.
# Set to true for Socket Mode (WebSockets, requires SLACK_APP_TOKEN).
# Set to false for HTTP Events API (Webhooks, requires SLACK_SIGNING_SECRET).
SLACK_SOCKET_MODE=true

# Required for Socket Mode (SLACK_SOCKET_MODE=true).
SLACK_APP_TOKEN=xapp-...

# Required for HTTP Events API (SLACK_SOCKET_MODE=false).
# SLACK_SIGNING_SECRET=your-signing-secret
# PORT=3000

# Concurrency & limits.
SLACK_AGENT_MAX_CONCURRENT=4

# Path to sera-mcp build (overrides default lookup).
# SERA_MCP_DIST=/absolute/path/to/sera-mcp/dist/index.js

# Forwarded to the spawned sera-mcp child:
SERA_NETWORK=mainnet
POLICY_PRESET=standard

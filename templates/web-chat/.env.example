# templates/web-chat — Express + browser chat UI over sera-mcp.

# Required.
OPENAI_API_KEY=sk-...

# Port the Express server listens on.
PORT=3000

# Required only if SERA_MCP_URL is not set. Path to a built sera-mcp/dist/index.js.
SERA_MCP_DIST=/absolute/path/to/sera-mcp/dist/index.js

# Optional: takes precedence over SERA_MCP_DIST and connects over Streamable
# HTTP instead of spawning a local MCP process. The hosted endpoint is keyless.
# SERA_MCP_URL=https://agents.sera.cx/mcp
# Optional Bearer token for a self-hosted SERA_MCP_URL. Never commit a real token.
# Requires an https:// SERA_MCP_URL, or an explicit localhost/127.0.0.1/::1 URL
# for local dev — plaintext http to any other host is rejected at startup.
# SERA_MCP_TOKEN=replace-with-your-token

# Forwarded to the spawned sera-mcp child. Defaults are safe for a multi-user
# browser chat: testnet + read-only (no fund-moving tools). The signer is pinned
# to `external` in code regardless, so the agent can only emit unsigned intents.
SERA_NETWORK=sepolia
POLICY_PRESET=standard
# Execution tools are OFF by default. Turning them on lets EVERY authenticated
# chat user reach fund-moving tools (a prompt-injection path). Only enable if you
# accept that, and keep SERA_NETWORK on a testnet unless you mean real settlement.
# SERA_ENABLE_EXECUTION_TOOLS=true

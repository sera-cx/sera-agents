# Caddyfile — agents.sera.cx public ingress. Caddy terminates TLS (automatic
# Let's Encrypt) for the agents.sera.cx host and is the only host-published
# service. It reverse-proxies dynamic agent routes to the gateway container and
# everything else to the static landing — both reachable only on the internal
# compose `edge` network (see the project-root docker-compose.yml).
#
# The gateway already returns 429 + Retry-After when Sera throttles; reverse_proxy
# forwards those upstream headers so backoff hints reach clients intact. The
# per-IP rate_limit below is a coarse noisy-neighbour brake in front of that.
#
# rate_limit needs the caddy-ratelimit plugin, baked into the image built from
# agents-gateway/deploy/Dockerfile.caddy — stock caddy:2-alpine does NOT include
# it. If you switch the compose `caddy` service back to a stock image, remove
# the global `order rate_limit` line and the rate_limit block below, or Caddy
# will fail to start.

{
	order rate_limit before basic_auth
}

agents.sera.cx {
	encode zstd gzip

	# Dynamic — the gateway.
	@gateway path /mcp /mcp/* /openapi.json /health /quote /settle /corridors /rates
	handle @gateway {
		# Coarse per-IP brake: 120 requests/min/IP across the API surface. This
		# is defence-in-depth in front of Sera's own account-level limits.
		rate_limit {
			zone agents_api {
				key    {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy gateway:8787 {
			header_up X-Forwarded-For {remote_host}
			health_uri      /health
			health_interval 10s
			health_timeout  2s
		}
	}

	# Everything else — static landing page + /docs/*.
	handle {
		reverse_proxy static:80
	}
}

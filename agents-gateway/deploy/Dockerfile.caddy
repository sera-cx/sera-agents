# Caddy with the caddy-ratelimit plugin baked in — required by the per-IP
# rate_limit block in Caddyfile. Stock caddy:2-alpine does not ship the plugin,
# so Caddy would fail to start on that block without this image.
FROM caddy:2-builder-alpine@sha256:95a5e7e2692b5eb9545aadc5b90a39f6f509bee59c9508a493f83ee902eaef63 AS builder
RUN xcaddy build --with github.com/mholt/caddy-ratelimit

FROM caddy:2-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# x402 v2 service. Demo is localhost only.
X402_MODE=demo
PORT=8402

# Live Base Sepolia (required before any mainnet use)
# X402_MODE=live
# X402_NETWORK=eip155:84532
# X402_TESTNET_ACK=true
# X402_PUBLIC_URL=https://x402-staging.example.com
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_CDP_API_KEY_ID=...       # load from a secret manager
# X402_CDP_API_KEY_SECRET=...   # never log or commit
# X402_VAULT_ADDRESS=0x...
# X402_CONFIRMATION_DEPTH=3
# X402_STATE_DB=./x402-state.db

# Mainnet needs a successful Sepolia E2E attestation as well as a separate ack.
# X402_NETWORK=eip155:8453
# X402_MAINNET_ACK=true
# X402_E2E_ATTESTATION_ID=attest-YYYYMMDD-commit-payment

# Sera testnet preconditions for E2E: dedicated vault and recipient only.
# SERA_NETWORK=sepolia
# SERA_SIGNER_MODE=local
# SIGNER_PRIVATE_KEY=...
# SERA_API_KEY=...
# SERA_API_SECRET=...

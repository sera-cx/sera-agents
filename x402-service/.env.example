# x402-service — protocol-level FX delivery endpoint (402 → pay USDC → swap → deliver).

# ─── Mode ───────────────────────────────────────────────────
# demo (default)  — self-contained; verifyPayment short-circuits; safe to run locally
# live            — CDP facilitator verify + settle; requires X402_LIVE_ACK=true
#                   and Base Sepolia E2E before mainnet (see SECURITY-MODEL.md).
X402_MODE=demo

# Port the Hono server listens on.
PORT=8402

# Required. Path to a built sera-mcp/dist/index.js.
SERA_MCP_DIST=/absolute/path/to/sera-mcp/dist/index.js

# ─── Live-mode requirements (when X402_MODE=live) ───────────
# Facilitator backend: cdp (Coinbase-hosted, default) or selfhosted (your own
# x402 facilitator — any EVM chain incl. Ethereum Sepolia).
# X402_FACILITATOR_KIND=cdp
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_CDP_API_KEY_ID=...                            # CDP API Key Identifier (cdp kind only)
# X402_CDP_API_KEY_SECRET=...                        # CDP EC private key (PEM format, standard newlines or escaped \n)
# X402_VAULT_ADDRESS=0x...
# X402_LIVE_ACK=true                                 # Operator acknowledgment required for live mode
# X402_NETWORK=base
# X402_MAINNET_ACK=true                              # Required in addition to X402_LIVE_ACK on Base mainnet
# X402_E2E_ATTESTATION_ID=...                        # ID/reference for the completed Base Sepolia E2E run
# X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_CONFIRMATION_DEPTH=3
#
# On-chain confirmation gate (REQUIRED in live mode): an RPC endpoint YOU
# control on the payment chain. The service independently confirms the USDC
# payment landed in the vault before executing any swap, so a compromised
# facilitator cannot trigger free delivery.
# X402_RPC_URL=https://...
# X402_SKIP_ONCHAIN_CONFIRM=true                     # explicit opt-out (NOT recommended)
#
# Durable single-use ledger (REQUIRED in live mode): the on-chain settle tx is
# consumed once so it can't be replayed; must survive restarts.
# X402_STATE_DB=/var/lib/x402/state.db
#
# EIP-3009 signature verification (makes the payer `from` un-forgeable). chainId
# is auto-derived from X402_NETWORK for base/base-sepolia/polygon/arbitrum and
# from any eip155:<id>; set X402_CHAIN_ID for anything else. name/version are the
# payment token's EIP-712 domain (USDC defaults shown).
# X402_CHAIN_ID=11155111
# X402_USDC_NAME=USD Coin
# X402_USDC_VERSION=2
#
# ─── Self-hosted facilitator example (Ethereum Sepolia) ─────
# Run your own facilitator (e.g. the Apache-2.0 reference from coinbase/x402)
# and point everything at Ethereum Sepolia — no Coinbase dependency:
# X402_FACILITATOR_KIND=selfhosted
# X402_FACILITATOR_URL=https://your-facilitator.example/x402
# X402_FACILITATOR_TOKEN=...                         # optional static bearer for YOUR facilitator
# X402_NETWORK=eip155:11155111
# X402_USDC_ADDRESS=0x...                            # USDC on your chain (required for selfhosted; no safe default)
# X402_RPC_URL=https://sepolia.example-rpc.io

# ─── Sera execution wiring (used by both demo and live) ────
# X402 takes USDC payment then calls sera.convert_and_send. Requires
# sera-mcp running in local-signer mode with a funded vault.
SERA_NETWORK=mainnet
SERA_SIGNER_MODE=local
SIGNER_PRIVATE_KEY=...               # wallet that signs convert_and_send. Use a wallet
                                     # you've INTENTIONALLY funded for this purpose only.
SERA_API_KEY=sera_...
SERA_API_SECRET=...

# Policy caps for the embedded sera-mcp (tight defaults for x402 surface).
POLICY_PRESET=starter
POLICY_MAX_NOTIONAL_USD=500
POLICY_DAILY_VOLUME_CAP_USD=5000

# ─── Persistence ────────────────────────────────────────────
# SQLite path for x402 payment state machine (pending → verified → delivered).
X402_DB_PATH=./x402-state.db

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
